{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Polotno",
  "mainBinaryName": "polotno",
  "version": "0.4.1",
  "identifier": "by.kobyla.polotno",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Полотно",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "maximized": true,
        "backgroundColor": "#212121",
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "kobyla.by",
    "homepage": "https://kobyla.by/artifacts/polotno",
    "copyright": "© 2026 kobyla.by",
    "category": "Productivity",
    "shortDescription": "Полотно — бесконечный причинно-семантический холст",
    "longDescription": "Второй мозг одного человека: бесконечный холст с карточками, причинными связями, группами и семантическим зумом. Всё хранится локально.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["polotno"],
        "name": "Polotno.Workspace",
        "description": "Файл Полотна",
        "role": "Editor",
        "mimeType": "application/x-polotno+json"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
